{
  "format": "cv-maker-template",
  "schemaVersion": 2,
  "template": {
    "id": "atelier.canvas",
    "revision": 1,
    "label": "Canvas libre",
    "description": "Deux pages avec cadres indépendants, aplats et typographie par élément.",
    "spec": {
      "canvas": {
        "pages": [
          {
            "background": 4294967295,
            "elements": [
              { "id": "band", "type": "rectangle", "x": 0, "y": 0, "width": 210, "height": 65, "background": 4280290104 },
              { "id": "name", "type": "text", "x": 18, "y": 16, "width": 140, "height": 16, "binding": "personalInfo.fullName", "fontSize": 28, "bold": true, "color": 4294967295 },
              { "id": "headline", "type": "text", "x": 18, "y": 35, "width": 135, "height": 18, "binding": "personalInfo.headline", "fontSize": 13, "color": 4294967295 },
              { "id": "portrait", "type": "photo", "x": 168, "y": 15, "width": 28, "height": 36, "radius": 4 },
              { "id": "email", "type": "text", "x": 18, "y": 72, "width": 108, "height": 12, "binding": "personalInfo.email", "fontSize": 10 },
              { "id": "location", "type": "text", "x": 135, "y": 72, "width": 58, "height": 12, "binding": "personalInfo.location", "fontSize": 10, "align": "right" },
              { "id": "profile", "type": "text", "x": 18, "y": 90, "width": 174, "height": 36, "binding": "profile", "fontSize": 11, "padding": 3, "background": 4294112245, "radius": 3 },
              { "id": "experience", "type": "section", "x": 18, "y": 135, "width": 174, "height": 142, "section": "experiences", "fontSize": 10 }
            ]
          },
          {
            "elements": [
              { "id": "education", "type": "section", "x": 18, "y": 18, "width": 108, "height": 100, "section": "education", "fontSize": 10 },
              { "id": "skills", "type": "section", "x": 137, "y": 18, "width": 55, "height": 100, "section": "skills", "fontSize": 10, "padding": 3, "background": 4294112245, "radius": 3 },
              { "id": "languages", "type": "section", "x": 18, "y": 130, "width": 100, "height": 50, "section": "languages", "fontSize": 10 },
              { "id": "projects", "type": "section", "x": 18, "y": 190, "width": 174, "height": 87, "section": "projects", "fontSize": 10 }
            ]
          }
        ]
      }
    }
  }
}
